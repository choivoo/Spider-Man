# ---- Server-side only (never prefix with VITE_) ----
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low

# Optional OpenAI-compatible TTS endpoint used by /api/tts (leave empty to use the browser voice)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# Optional cloud memory (Supabase). Leave empty to keep memory on this device.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
